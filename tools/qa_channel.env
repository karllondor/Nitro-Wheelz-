# Nitro Wheelz — ONE Android QA channel (issue #68). Read by .github/workflows/android-debug.yml for the
# integration/stable-mobile-qa lane. Every QA candidate MUST keep the same package and certificate and use a
# versionCode ABOVE QA_LAST_VERSION_CODE, so Android installs it as an UPDATE of the owner's QA app (saves kept).
# After an APK is handed to the owner, raise QA_LAST_VERSION_CODE to its versionCode in the next candidate.
QA_PACKAGE=com.karllondor.nitrowheelz.review.pr45
QA_LABEL="Nitro Wheelz QA"
QA_CERT_SHA256=CD:1A:E2:A4:A2:54:19:1A:E4:23:BF:23:A6:BC:C6:0F:A8:2D:36:9D:13:96:51:4B:B1:75:4E:0C:66:9B:7B:E2
QA_LAST_VERSION_CODE=53
